rules_version = '2';

// قواعد أمان Firestore لتطبيق "دوائي" (NFR-03)
// - كلمات المرور لا تُخزَّن في قاعدة البيانات (تتولاها Firebase Authentication).
// - كل مستخدم مسجل يقرأ الصيدليات والأدوية والتوفر (للبحث).
// - الصيدلي فقط يكتب بيانات صيدلياته وسجلات التوفر الخاصة بها.
// - المستخدم العادي لا يستطيع تعديل بيانات الصيدليات أو الأدوية.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isPharmacist() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(uid())).data.userType == 'pharmacist';
    }
    function ownsPharmacy(pharmacyId) {
      return isPharmacist()
        && exists(/databases/$(database)/documents/pharmacies/$(pharmacyId))
        && get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.ownerId == uid();
    }
    function validPharmacy(d) {
      return d.ownerId == uid()
        && d.pharmacyName is string && d.pharmacyName.size() > 0
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180;
    }
    function validStock(d) {
      return d.price is number && d.price >= 0
        && d.quantity is int && d.quantity >= 0;
    }

    // المستخدمون: كل مستخدم يقرأ ويكتب وثيقته فقط، ولا يمكن تغيير نوع الحساب.
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
        && request.resource.data.userId == userId
        && request.resource.data.userType in ['user', 'pharmacist']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if signedIn() && uid() == userId
        && request.resource.data.userType == resource.data.userType;
      allow delete: if false;
    }

    // الصيدليات: الصيدلي الواحد قد يدير أكثر من صيدلية (ownerId).
    match /pharmacies/{pharmacyId} {
      allow read: if signedIn();
      allow create: if isPharmacist()
        && request.resource.data.pharmacyId == pharmacyId
        && validPharmacy(request.resource.data);
      allow update: if isPharmacist()
        && resource.data.ownerId == uid()
        && validPharmacy(request.resource.data);
      allow delete: if isPharmacist() && resource.data.ownerId == uid();
    }

    // الأدوية: قائمة عامة مشتركة ينشئها الصيدلي عند إضافة دواء غير موجود.
    match /medicines/{medicineId} {
      allow read: if signedIn();
      allow create: if isPharmacist()
        && request.resource.data.tradeName is string
        && request.resource.data.tradeName.size() > 0
        && request.resource.data.scientificName is string
        && request.resource.data.scientificName.size() > 0
        && request.resource.data.pharmaceuticalForm is string
        && request.resource.data.pharmaceuticalForm.size() > 0
        && request.resource.data.searchKeys is list;
      allow update, delete: if false;
    }

    // توفر الأدوية: الصيدلي يدير سجلات صيدلياته فقط.
    match /availability/{availabilityId} {
      allow read: if signedIn();
      allow create: if ownsPharmacy(request.resource.data.pharmacyId)
        && availabilityId == request.resource.data.pharmacyId + '_' + request.resource.data.medicineId
        && validStock(request.resource.data);
      allow update: if ownsPharmacy(resource.data.pharmacyId)
        && request.resource.data.pharmacyId == resource.data.pharmacyId
        && request.resource.data.medicineId == resource.data.medicineId
        && validStock(request.resource.data);
      allow delete: if ownsPharmacy(resource.data.pharmacyId);
    }
  }
}
